# Shared Whole Body Supabase project (public browser credentials only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy projects may expose an anon key instead of a publishable key.
# Leave unset when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
